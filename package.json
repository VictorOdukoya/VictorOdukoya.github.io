{
  "name": "victor-odukoya-website",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal developer website for Victor Odukoya",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev",
