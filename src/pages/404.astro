---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Page not found — Victor Odukoya" description="The requested page could not be found." noindex>
  <section class="section gradient-bg pt-32">
    <div class="container-custom max-w-3xl">
      <p class="text-primary-600 dark:text-primary-400 font-semibold mb-4">404</p>
      <h1 class="text-3xl sm:text-4xl font-display font-bold mb-6">Page not found</h1>
      <p class="text-gray-600 dark:text-gray-300 mb-8">This page is unavailable. Explore the apps or get in touch if you need help.</p>
      <a class="btn-gradient" href="/apps">Explore apps</a>
    </div>
  </section>
</PageLayout>
